{
  "name": "furama-cuisine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-script-fonts.mjs && next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "db:migrate": "dotenv -e .env.local -- node scripts/migrate.mjs",
    "db:psql": "dotenv -e .env.local -- sh -c 'psql $DATABASE_URL_UNPOOLED'"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.9",
    "better-auth": "^1.7.7",
    "botid": "1.5.11",
    "intl-messageformat": "^12.1.2",
    "libphonenumber-js": "^1.13.14",
    "next": "^16.3.7",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "auth": "^1.7.7",
    "dotenv-cli": "^11.0.0",
    "jiti": "^2.7.0",
    "oxc-parser": "^0.152.0",
    "oxlint": "^1.86.0",
    "smtp-server": "^3.19.16",
    "typescript": "^7.0.2",
    "undici": "^6.29.0",
    "vitest": "^5.0.3"
  }
}
